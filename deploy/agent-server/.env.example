# Агентский сервер Kaiten — настройки. Скопируйте в .env и заполните; .env в git не попадает.

# Секрет сервера, 32+ символов: openssl rand -hex 32
# Им зашифрованы ключи агентов: сменили — все ключи и подключения недействительны.
SERVER_SECRET=

# Домен компании в Kaiten.
KAITEN_DOMAIN=acme.kaiten.ru

# Внешний адрес сервера (https, без пути) и его имя хоста для Caddy.
PUBLIC_URL=https://agent.example.com
AGENT_HOST=agent.example.com
