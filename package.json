{
  "name": "kaiten-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Синхронизатор задач репозиториев Acme и Kaiten: разовая заливка, дальше цикл сверки",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "import": "tsx --env-file-if-exists=.env src/import.ts",
    "inspect": "tsx --env-file-if-exists=.env src/inspect.ts",
    "yonote": "tsx --env-file-if-exists=.env src/yonote.ts",
    "setup": "tsx --env-file-if-exists=.env src/setup.ts",
    "tasks:lint": "tsx src/tasks-lint.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
