{
  "name": "kaiten-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Задачи файлами в git ↔ Kaiten: команда kaiten для разработчиков и ИИ-агентов",
  "bin": {
    "kaiten": "bin/kaiten.mjs"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "import": "tsx --env-file-if-exists=.env src/import.ts",
    "inspect": "tsx --env-file-if-exists=.env src/inspect.ts",
    "yonote": "tsx --env-file-if-exists=.env src/yonote.ts",
    "setup": "tsx --env-file-if-exists=.env src/setup.ts",
    "tasks:lint": "tsx --env-file-if-exists=.env src/tasks-lint.ts",
    "convert": "tsx --env-file-if-exists=.env src/convert.ts",
    "kaiten": "tsx src/kaiten.ts",
    "kaiten-sync": "tsx --env-file-if-exists=.env src/kaiten-sync-cli.ts",
    "assess": "tsx --env-file-if-exists=.env src/assess.ts",
    "found": "tsx --env-file-if-exists=.env src/found.ts",
    "reopen": "tsx --env-file-if-exists=.env src/reopen.ts",
    "backup": "tsx --env-file-if-exists=.env src/kaiten-backup.ts",
    "connect-repo": "tsx src/connect-repo.ts",
    "normalize": "tsx src/normalize-tasks.ts",
    "install-machine": "node scripts/install.mjs",
    "agent:dev": "pnpm dlx wrangler@4.145.0 dev",
    "agent:deploy": "pnpm dlx wrangler@4.145.0 deploy",
    "agent:build": "node scripts/build-agent-server.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.2",
    "@types/node": "^25.6.0",
    "esbuild": "0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
