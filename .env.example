# Домен аккаунта Kaiten без схемы, например acme.kaiten.ru
KAITEN_DOMAIN=
# Токен из профиля Kaiten. В репозиторий не коммитить.
KAITEN_TOKEN=
# Домен команды yonote, например acme.yonote.ru (схема не обязательна) — для разовой выгрузки.
YONOTE_DOMAIN=
# Токен API yonote (профиль → API). Только чтение нужно; в репозиторий не коммитить.
YONOTE_TOKEN=
